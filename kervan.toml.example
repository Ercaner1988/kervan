# Kervan hesap havuzu - Örnek yapılandırma
#
# ADLANDIRMA: profil adı = HESAP ADININ KENDISI.
# Örnek: "kullanici@example.com" profil dizini adıdır.
#
# BIR PROFIL = BIR KIMLIK. Sağlayıcılar sekmedir: aynı Google oturumu
# aynı tarayıcıda gemini, perplexity sekmelerine birden yeter.

# Hız bütçesi: bot tespitini yenmek için değil, gerçekten normal bir kullanıcı
# gibi davranmak için. Hesap başına uygulanır.
[pacing]
min_delay_ms = 3000   # aynı hesaba ardışık iki istek arası en az süre
jitter_ms = 2000      # üzerine 0-2 sn rastgele sapma (sabit aralık en belirgin bot izidir)
hourly_cap = 30       # hesap başına saatlik tavan; 0 = sınırsız (önerilmez)

# Sağlayıcı seçim stratejisi: 'auto' modeli istendiğinde adaylar (eklenti
# sekmeleri + havuz hesapları + [rest.*] hedefleri) arasından hangi sırayla
# seçilir. Çalışma anında değiştirme: POST /yonlendirme {"strateji":"round-robin"}
#
# DİKKAT — 20 ad kabul edilir; üretimde sırayı fiilen değiştiren yalnız 7:
#   weighted, round-robin, p2c, random, strict-random, least-used, lkgp.
# Sırayı değiştirmeyen 13 ad iki gruptur:
#   - henüz taşınmadı (açılışta uyarı basılır): reset-aware, reset-window,
#     headroom, quota-weighted, auto, cache-optimized, fusion, pipeline
#   - uyarısız ama etkisiz: cost-optimized, context-optimized (fiyat/bağlam
#     tablosu üretimde boş); priority, fill-first, context-relay (çekirdek
#     sırayı dokunmaz; üretimde aday listesi zaten alfabetik gelir)
#
# `quota-share` dahili stratejidir; yapılandırmadan ve POST /yonlendirme'den
# reddedilir.
[yonlendirme]
strateji = "lkgp"     # lkgp: son başarılı sağlayıcıya yapış (devre kesiciyle birlikte)
yedek_deneme = true   # başarısız adaydan sonra sıradakine geç
azami_deneme = 3      # tek istekte en fazla kaç aday denenecek

# --- örnek hesaplar ---
#
# Yeni sağlayıcı bağlamak: görünür kipte aç, sekmede giriş yap, kapat.
#
#     cargo run -- --giris "<hesap>"
#
# Sonra `cargo run -- --tara` ile gerçekte hangi oturumların açıldığını ÖLÇ;
# bu dosyayı tahminle değil ölçümle doldur.

[[accounts]]
name = "kullanici1@example.com"
providers = ["gemini", "perplexity"]

[[accounts]]
name = "kullanici2@example.com"
providers = ["gemini", "kimi"]

[[accounts]]
name = "kullanici3@work.edu.tr"
providers = ["gemini", "copilot-m365"]

# Kisisel Microsoft hesabı. Google tarafında karşılığı yok;
# Copilot'un kişisel sürümü iş/okul sürümünden ayrı ürün, ayrı kota.
[[accounts]]
name = "kullanici4@hotmail.com"
providers = ["copilot"]

# Kota limit ifadeleri (gözlemlendiğinde ekleyin)
[kota]
isaretler = ["reached your limit", "sınırına ulaştınız"]
bilinmeyen_pencere_dk = 60

# --- doğrudan REST sağlayıcıları ---
#
# Tarayıcı sekmesi yerine kendi API'sine giden sağlayıcı. `auto` adaylarına
# katılır; `kervan/<ad>` açık adıyla da çağrılabilir. Anahtar dosyada DEĞİL,
# adı verilen ortam değişkeninde durur.
#
# Ad kuralları:
#   - `auto` rezervedir, [rest.auto] açılışta hata verir.
#   - Hesap/`providers` adıyla çakışan [rest.X] hata verir (tarayıcı hesabını
#     sessizce gölgelemesin).
#   - Eklentinin sabit adları (gemini, deepseek, chatgpt, …) yazılırsa açılışta
#     `uyari:` basılır; bilinçli tercih olabilir ama sessiz kalmaz.
#
# [rest.deepseek]
# bicim = "openai"                     # openai | claude | gemini
# taban_url = "https://api.deepseek.com"
# anahtar_env = "DEEPSEEK_API_KEY"
# model = "deepseek-chat"
# yol = "/v1/chat/completions"         # isteğe bağlı; biçime göre varsayılan var

# --- tarayıcı model menüsü ---
#
# Bir sağlayıcının arayüzünde GERÇEKTEN seçilebilen model varsa burada tanımlanır
# ve `kervan/<sağlayıcı>/<kod>` adları `/v1/models` listesine girer.
#
# Kural: yalnız ÖLÇÜLMÜŞ menü yazılır. Elle yazılmış katalog ya da tahmin edilmiş
# seçici kabul edilmez — yanlış seçici, "seçtim" sanıp varsayılan modelle cevap
# vermek demek. Ölçüm: `kervan --tikla '<seçici>' --js '<betik>'` ile menü
# düğmesi/öğeleri okunur, hangi öğenin tıklamayla gerçekten seçildiği görülür.
#
# ÜÇÜ BİRLİKTE zorunlu: model_dugmesi + model_oge + modeller. Yarım tanım
# yüklemede reddedilir. Kod tanımsızsa istek 400, menü hiç tanımsızsa 501 döner;
# ikisi de sessizce varsayılana düşmez.
#
# Ölçülmüş örnek (gemini, 2026-10-22, ücretsiz hesap): menüdeki "3.1 Pro" /
# "4 Argon" öğeleri `data-mode-id="upsell_..."`, yani ücretli plan gerektiriyor ve
# tıklanınca seçim uygulanmıyor. Seçilebilir eksen DÜŞÜNME DÜZEYİ olduğu için
# kodlar düşünme düzeyleridir.
#
# [providers."gemini"]
# model_dugmesi = "button[aria-label*='Mod seçici']"
# model_oge = "[role=menuitem]"
# modeller = [
#   { kod = "dusuk", etiket = "Düşük" },
#   { kod = "orta", etiket = "Orta" },
#   { kod = "yuksek", etiket = "Yüksek" },
#   # Menüde GÖRÜNÜYOR ama bu hesapta SEÇİLMİYOR (ücretli plan). `kilitli = true`
#   # olan kod istenirse Kervan siteye hiç dokunmaz ve 402 döner: hesabın
#   # potansiyeli görünür, sessizce site varsayılanına düşülmez.
#   { kod = "3-1-pro", etiket = "3.1 Pro", kilitli = true, kilit_nedeni = "ücretli plan gerekiyor" },
#   { kod = "4-argon", etiket = "4 Argon", kilitli = true, kilit_nedeni = "ücretli plan gerekiyor" },
# ]
#
# Ölçülmüş örnek (kimi / kimi.ai, 2026-10-22): menüde üç model var, seçim işareti
# öğenin kendi `checked` sınıfı. "Düşünme yoğunluğu" ayrı bir alt eksendir ve bu
# tanıma girmez; yalnız model ekseni kodlanır. Öğe adı ilk satırdan okunur, bu
# yüzden "K2.8 Preview · ..." öğesinin etiketi "K2.8"dir.
#
# [providers."kimi"]
# model_dugmesi = "[data-testid='model-select-trigger']"
# model_oge = "[role=menuitemradio][data-testid='model-option']"
# modeller = [
#   { kod = "k3", etiket = "K3" },
#   { kod = "k2-8", etiket = "K2.8" },
#   { kod = "hizli", etiket = "Hızlı" },
# ]
#
# Ölçülmüş örnek (z.ai / chat.z.ai, 2026-10-22): seçim işareti
# `data-selected="true"`. Etiketler TAM ad olmalı: "GLM-5.3" ile "GLM-5.3-Flash"
# birbirinin içinde geçer, eşleştirme önce ad tam eşitliğine bakar.
#
# [providers."z.ai"]
# model_dugmesi = "button.modelSelectorButton"
# model_oge = "[role=menu] button[data-value]"
# modeller = [
#   { kod = "glm-5.3-flash", etiket = "GLM-5.3-Flash" },
#   { kod = "glm-5.3", etiket = "GLM-5.3" },
#   { kod = "glm-5.2", etiket = "GLM-5.2" },
# ]
#
# Ölçülmüş örnek (deepseek / chat.deepseek.com, 2026-10-22): MODEL MENÜSÜ YOK.
# İki bağımsız aç/kapa düğmesi var (`.ds-toggle-button`), durum `aria-pressed`.
# Bu yüzden model kodu değil `anahtarlar` tanımlanır: istek gövdesindeki
# `kervan.anahtarlar` alanıyla istenir, Kervan durumu okur, uygular ve yeniden
# okuyarak doğrular. Doğrulanamazsa istek açık hataya düşer.
#
# [providers."deepseek"]
# [[providers."deepseek".anahtarlar]]
# kod = "derin"
# dugme = ".ds-toggle-button"
# etiket = "DeepThink"
#
# [[providers."deepseek".anahtarlar]]
# kod = "arama"
# dugme = ".ds-toggle-button"
# etiket = "Search"
#
# ÖLÇÜLEMEYENLER (2026-10-22) — kod yazmak yanlış model riski taşır:
#   perplexity: menü öğelerinin hepsi `aria-haspopup=menu` taşıyor ama fareyle
#     açılan alt menü yalnız "Upgrade plan" tanıtımı; modelin kendi seçim işareti
#     DOM'da HİÇ yok (aria-checked/class işareti yok). Seçim doğrulanamadığı için
#     kodlanmadı: doğrulanamayan seçim sessiz yanlış model demektir.


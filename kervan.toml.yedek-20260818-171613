# CLAUDE BILEREK YOK.
#
# Olculdu: uc hesabin ucunde de claude.ai, WebDriver ile surulen tarayicida
# Cloudflare dogrulamasini SURSUZ tekrar soruyor — elle cozulse bile bir sonraki
# acilista yeniden cikiyor. Sebebi acik: Cloudflare'in verdigi `cf_clearance`
# tarayicinin parmak izine bagli ve WebDriver'la surulen Firefox kendini
# otomasyon olarak bildiriyor (`navigator.webdriver`), o yuzden izin yapismiyor.
#
# Bunu yapistirmanin tek yolu otomasyon imzasini gizlemek, yani parmak izi
# sahteciligi. Plandaki "yapilmayacaklar" listesinin ilk maddesi bu: duvari
# asmiyoruz, gosteriyoruz. Hesaplari burada tutmak sonuc vermeden claude.ai'a
# tekrar tekrar otomatik istek atmak olurdu — hem bosuna hem de o hesaplari
# gereksiz yere isaretletir.
#
# Claude'a erisim yolu simdilik OmniRoute (API anahtarli / OAuth) ve elle
# tarayici. Duvar kalkarsa `providers` listesine "claude" eklemek yeterli;
# saglayici tanimi kodda duruyor.
#
# DEEPSEEK, QWEN VE Z.AI BILEREK YOK — claude ile ayni sebep.
#
# 2026-08-16 giris turunda yedi Google kimliginin HEPSINDE denendi: deepseek,
# qwen, z.ai ve (erercan1988 disinda) perplexity, WebDriver ile surulen
# tarayicida Cloudflare dogrulamasina takildi. Takilmayanlar Google (gemini),
# Microsoft (copilot) ve Moonshot (kimi) — yani sorun saglayiciya degil,
# Cloudflare + WebDriver bilesimine ozgu. Asmanin yolu otomasyon imzasini
# gizlemek olurdu; yapmiyoruz.
#
# Z.AI'nin belirtisi digerlerinden farkliydi ve yaniltiyordu: duvar gorunmuyor,
# istem gidiyor, asistan balonu ACILIYOR ama BOS kaliyor. Havuz uzerinden 0/3,
# toplam 1/7 (tek basari 9.9 sn'de dogru cevap verdi). Yani "yavas" degil,
# sessizce engelli — her istek 120 sn bosa yakiyordu.
#
# PERPLEXITY yalnizca erercan1988'de: ayni turda diger alti kimlikte duvara
# takildi, o profilde ise havuzdan ucdan uca calisti (26x4 -> 104). Yani
# "her zaman engelli" degil, KARARSIZ.
#
# Saglayici tanimlari kodda duruyor; duvar kalkarsa listeye ad eklemek yeterli.

# Hiz butcesi: bot tespitini yenmek icin degil, gercekten normal bir kullanici
# gibi davranmak icin. Hesap basina uygulanir.
[pacing]
min_delay_ms = 3000   # ayni hesaba ardisik iki istek arasi en az sure
jitter_ms = 2000      # uzerine 0-2 sn rastgele sapma (sabit aralik en belirgin bot izidir)
hourly_cap = 30       # hesap basina saatlik tavan; 0 = sinirsiz (onerilmez)
